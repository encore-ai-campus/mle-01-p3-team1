NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
SUPERVISOR_MODEL=gpt-6-luna
RAGAS_JUDGE_MODEL=gpt-4o-mini
MUSEUM_QUERY_ANALYSIS_ENABLED=false

# 구조 조건(편의시설·개관 요일) 후보 필터. off로 끄면 이전 Hybrid 동작과 같음
HYBRID_ONTOLOGY_FILTER=on

# 질문에 적힌 시설명을 재정렬 후보에 반드시 포함. off로 끄면 이전 동작
HYBRID_NAME_MATCH=on
# 재정렬 최고 점수가 이 값보다 낮으면 RRF 순서 유지 (0이면 끔)
HYBRID_RERANK_MIN_CONFIDENCE=0.1
