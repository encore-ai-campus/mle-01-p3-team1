flowchart TB
    Q["사용자 질문<br/>Supervisor CLI"] --> GI{"입력 가드레일<br/>실패 시 1회 재시도"}
    GI -->|허용| S["Supervisor<br/>경로 선택"]
    GI -->|차단| BLOCK["차단 안내"]

    S -->|"① 편의시설 · 개관 요일 조건"| F0
    S -->|"② 단순 지역 + 주제"| V
    S -->|"③ 그 밖의 설명형 질문<br/>LLM 라우터"| V
    S -->|"④ 준비된 쿼리 · 관계 · 출처<br/>Graph 연결 시"| GRAPH

    subgraph HYB["Hybrid 검색 Agent"]
        direction TB
        F0["0. 온톨로지 후보 필터<br/>편의시설 · 개관 요일 (+ 지역)"]
        LOCAL[("로컬 조회표<br/>rules.py · CSV (기본)")]
        NEOV2[("Neo4j v2<br/>같은 규칙 · 선택")]
        V["Chroma Vector 검색"]
        B["BM25 키워드 검색"]
        RRF["가중 RRF · 후보 결합"]
        NAME["이름 보장<br/>질문에 적힌 시설명을 후보에 포함"]
        CE["Cross-Encoder 재정렬<br/>확신이 낮으면 RRF 순서 유지"]
        LOCAL --> F0
        NEOV2 -.-> F0
        F0 -->|"후보 ID"| V
        F0 -->|"후보 ID"| B
        V --> RRF
        B --> RRF
        RRF --> NAME --> CE
    end

    CE --> SRC["CSV 출처 · 속성 근거 연결"]
    CSV[("museum_final_738.csv")] --> SRC
    GRAPH <--> NEO[("Neo4j Aura<br/>기존 그래프 + v2")]
    SRC --> ANSWER["답변 생성"]
    GRAPH --> ANSWER
    ANSWER --> VERIFY{"근거 · 답변 검증"}
    VERIFY -->|통과| OK["답변과 출처"]
    VERIFY -->|"근거 부족 · 재시도 1회<br/>직전이 Graph면 Hybrid로"| S
    VERIFY -->|"재시도 소진<br/>또는 조건을 만족하는 기록 0건"| HOLD["답변 보류<br/>없는 조건을 안내"]
    OK --> GO{"출력 가드레일"}
    HOLD --> GO
    GO -->|허용| OUT["최종 결과"]
    GO -->|차단| BLOCK

